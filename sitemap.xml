---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}{% unless p.sitemap == false %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.last_modified_at | default: site.time | date_to_xmlschema }}</lastmod></url>
{%- endunless %}{% endfor %}
  <url><loc>{{ "/ai4g/" | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod></url>
{%- for p in site.posts %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
</urlset>
